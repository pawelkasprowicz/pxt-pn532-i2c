w><block type=\"PN532_lastError\"></block></value></block></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.No</field></block></next></block></statement></block></next></block></statement><statement name=\"ELSE\"><block type=\"serial_writeline\"><value name=\"text\"><block type=\"text_join\"><mutation items=\"2\"></mutation><value name=\"ADD0\"><shadow type=\"text\"><field name=\"TEXT\">BLAD: </field></shadow></value><value name=\"ADD1\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow><block type=\"PN532_lastError\"></block></value></block></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.No</field></block></next></block></statement></block></next></block></next></block></next></block></statement></block><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"serial_redirect_to_usb\"><data>0</data><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">1000</field></shadow></value><next><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">========================</field></shadow></value><next><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">PN532 - TEST PAMIECI</field></shadow></value><next><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">========================</field></shadow></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\")}*epmmRW,,se49_{r8,\">pn532Gotowy</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"PN532_init\"></block></value><next><block type=\"controls_if\"><mutation else=\"1\"></mutation><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\")}*epmmRW,,se49_{r8,\">pn532Gotowy</field></block></value><statement name=\"DO0\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">PN532 GOTOWY</field></shadow></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.Yes</field></block></next></block></statement><statement name=\"ELSE\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">BLAD INICJALIZACJI</field></shadow></value><next><block type=\"serial_writeline\"><value name=\"text\"><block type=\"PN532_lastError\"></block></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.No</field></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"// ========================================\r\n// PN532 - TEST MIFARE CLASSIC 1K\r\n// micro:bit V2\r\n//\r\n// A - ODCZYT TEKSTU\r\n// B - ZAPIS TEKSTU \"PAWEL\"\r\n// ========================================\r\n\r\nserial.redirectToUSB()\r\n\r\nbasic.pause(1000)\r\n\r\nserial.writeLine(\"========================\")\r\nserial.writeLine(\"PN532 - TEST PAMIECI\")\r\nserial.writeLine(\"========================\")\r\n\r\nlet pn532Gotowy = PN532.init()\r\n\r\nif (pn532Gotowy) {\r\n    serial.writeLine(\"PN532 GOTOWY\")\r\n    basic.showIcon(IconNames.Yes)\r\n} else {\r\n    serial.writeLine(\"BLAD INICJALIZACJI\")\r\n    serial.writeLine(PN532.lastError())\r\n    basic.showIcon(IconNames.No)\r\n}\r\n\r\n// PRZYCISK A - ODCZYT\r\n\r\ninput.onButtonPressed(Button.A, function () {\r\n\r\n    serial.writeLine(\"\")\r\n    serial.writeLine(\"ODCZYT KARTY\")\r\n\r\n    if (!pn532Gotowy) {\r\n        serial.writeLine(\"CZYTNIK NIEGOTOWY\")\r\n        basic.showIcon(IconNames.No)\r\n        return\r\n    }\r\n\r\n    if (PN532.detect()) {\r\n\r\n        serial.writeLine(\"UID: \" + PN532.uid())\r\n\r\n        let tekst = PN532.readText()\r\n\r\n        if (PN532.lastError() == \"\") {\r\n            serial.writeLine(\"TEKST: \" + tekst)\r\n            basic.showIcon(IconNames.Yes)\r\n        } else {\r\n            serial.writeLine(\"BLAD: \" + PN532.lastError())\r\n            basic.showIcon(IconNames.No)\r\n        }\r\n\r\n    } else {\r\n        serial.writeLine(\"BLAD: \" + PN532.lastError())\r\n        basic.showIcon(IconNames.No)\r\n    }\r\n})\r\n\r\n// PRZYCISK B - ZAPIS\r\n\r\ninput.onButtonPressed(Button.B, function () {\r\n\r\n    serial.writeLine(\"\")\r\n    serial.writeLine(\"ZAPIS KARTY\")\r\n\r\n    if (!pn532Gotowy) {\r\n        serial.writeLine(\"CZYTNIK NIEGOTOWY\")\r\n        basic.showIcon(IconNames.No)\r\n        return\r\n    }\r\n\r\n    if (PN532.detect()) {\r\n\r\n        serial.writeLine(\"UID: \" + PN532.uid())\r\n\r\n        if (PN532.writeText(\"PAWEL\")) {\r\n            serial.writeLine(\"ZAPIS OK\")\r\n            basic.showIcon(IconNames.Yes)\r\n        } else {\r\n            serial.writeLine(\"BLAD: \" + PN532.lastError())\r\n            basic.showIcon(IconNames.No)\r\n        }\r\n\r\n    } else {\r\n        serial.writeLine(\"BLAD: \" + PN532.lastError())\r\n        basic.showIcon(IconNames.No)\r\n    }\r\n})","README.md":"","pn532.ts":"//% color=#00897B icon=\"\\uf2c2\" block=\"PN532 NFC\"\nnamespace PN532 {\n\n    const ADDRESS = 0x24\n\n    let initialized = false\n    let cardPresent = false\n    let cardUID = \"\"\n    let errorText = \"\"\n    let uidBytes: number[] = []\n\n    function emptyBuffer(): Buffer {\n        return pins.createBuffer(0)\n    }\n\n    function hexByte(value: number): string {\n        let h = \"0123456789ABCDEF\"\n        return h.charAt((value >> 4) & 15) +\n            h.charAt(value & 15)\n    }\n\n    function clearCard() {\n        cardPresent = false\n        cardUID = \"\"\n        uidBytes = []\n    }\n\n    function sendCommand(data: number[]): boolean {\n\n        let len = data.length + 1\n        let sum = 0xD4\n\n        for (let i = 0; i < data.length; i++) {\n            sum += data[i]\n        }\n\n        let frame = pins.createBuffer(data.length + 8)\n\n        frame[0] = 0x00\n        frame[1] = 0x00\n        frame[2] = 0xFF\n        frame[3] = len\n        frame[4] = (256 - len) & 255\n        frame[5] = 0xD4\n\n        for (let i = 0; i < data.length; i++) {\n            frame[6 + i] = data[i]\n        }\n\n        frame[6 + data.length] =\n            (256 - (sum & 255)) & 255\n\n        frame[7 + data.length] = 0x00\n\n        let result = pins.i2cWriteBuffer(\n            ADDRESS, frame, false\n        )\n\n        if (result != 0) {\n            errorText = \"BLAD I2C\"\n            return false\n        }\n\n        return true\n    }\n\n    function waitReady(timeout: number): boolean {\n\n        let start = input.runningTime()\n\n        while (input.runningTime() - start < timeout) {\n\n            let status = pins.i2cReadBuffer(\n                ADDRESS, 1, false\n            )\n\n            if (status.length == 1 &&\n                status[0] == 0x01) {\n                return true\n            }\n\n            basic.pause(20)\n        }\n\n        return false\n    }\n\n    function readRaw(size: number, timeout: number): Buffer {\n\n        if (!waitReady(timeout)) {\n            errorText = \"TIMEOUT\"\n            return emptyBuffer()\n        }\n\n        let raw = pins.i2cReadBuffer(\n            ADDRESS, size, false\n        )\n\n        if (raw.length != size ||\n            raw[0] != 0x01) {\n\n            errorText = \"BLAD ODCZYTU I2C\"\n            return emptyBuffer()\n        }\n\n        return raw\n    }\n\n    function command(data: number[], timeout: number): Buffer {\n\n        errorText = \"\"\n\n        if (!sendCommand(data)) {\n            return emptyBuffer()\n        }\n\n        let ack = readRaw(7, 1000)\n\n        if (ack.length != 7) {\n            return emptyBuffer()\n        }\n\n        if (ack[1] != 0x00 ||\n            ack[2] != 0x00 ||\n            ack[3] != 0xFF ||\n            ack[4] != 0x00 ||\n            ack[5] != 0xFF ||\n            ack[6] != 0x00) {\n\n            errorText = \"BRAK ACK\"\n            return emptyBuffer()\n        }\n\n        let raw = readRaw(64, timeout)\n\n        if (raw.length != 64) {\n            return emptyBuffer()\n        }\n\n        if (raw[1] != 0x00 ||\n            raw[2] != 0x00 ||\n            raw[3] != 0xFF) {\n\n            errorText = \"BLAD RAMKI\"\n            return emptyBuffer()\n        }\n\n        let len = raw[4]\n\n        if (((len + raw[5]) & 255) != 0 ||\n            len < 2 ||\n            len + 8 > raw.length) {\n\n            errorText = \"BLAD DLUGOSCI\"\n            return emptyBuffer()\n        }\n\n        let sum = 0\n\n        for (let i = 0; i < len; i++) {\n            sum += raw[6 + i]\n        }\n\n        if (((sum + raw[6 + len]) & 255) != 0) {\n            errorText = \"BLAD SUMY\"\n            return emptyBuffer()\n        }\n\n        if (raw[6] != 0xD5 ||\n            raw[7] != data[0] + 1) {\n\n            errorText = \"ZLA ODPOWIEDZ\"\n            return emptyBuffer()\n        }\n\n        let result = pins.createBuffer(len)\n\n        for (let i = 0; i < len; i++) {\n            result[i] = raw[6 + i]\n        }\n\n        return result\n    }\n\n    function exchange(data: number[]): Buffer {\n\n        let cmd: number[] = [0x40, 0x01]\n\n        for (let i = 0; i < data.length; i++) {\n            cmd.push(data[i])\n        }\n\n        let r = command(cmd, 1500)\n\n        if (r.length < 3) {\n            return emptyBuffer()\n        }\n\n        if (r[0] != 0xD5 ||\n            r[1] != 0x41) {\n\n            errorText = \"BLAD WYMIANY\"\n            return emptyBuffer()\n        }\n\n        if (r[2] != 0x00) {\n            errorText = \"BLAD KARTY: \" +\n                hexByte(r[2])\n            return emptyBuffer()\n        }\n\n        return r\n    }\n\n    //% block=\"inicjalizuj PN532\"\n    //% group=\"Podstawowe\"\n    export function init(): boolean {\n\n        initialized = false\n        clearCard()\n        errorText = \"\"\n\n        let r = command(\n            [0x14, 0x01, 0x14, 0x01],\n            1000\n        )\n\n        if (r.length < 2) {\n            return false\n        }\n\n        initialized = true\n        return true\n    }\n\n    function detectOnce(): boolean {\n\n        clearCard()\n\n        let r = command(\n            [0x4A, 0x01, 0x00],\n            2500\n        )\n\n        if (r.length < 3) {\n            return false\n        }\n\n        if (r[2] == 0) {\n            errorText = \"BRAK KARTY\"\n            return false\n        }\n\n        if (r.length < 12) {\n            errorText = \"NIEPELNE DANE\"\n            return false\n        }\n\n        let uidLen = r[7]\n\n        if (uidLen != 4 ||\n            r.length < 8 + uidLen) {\n\n            errorText = \"NIEOBSLUGIWANA KARTA\"\n            return false\n        }\n\n        let atqa = hexByte(r[4]) + hexByte(r[5])\n        let sak = r[6]\n\n        if (atqa != \"0004\" || sak != 0x08) {\n            errorText = \"TO NIE CLASSIC 1K\"\n            return false\n        }\n\n        for (let i = 0; i < 4; i++) {\n            let b = r[8 + i]\n            uidBytes.push(b)\n            cardUID += hexByte(b)\n        }\n\n        cardPresent = true\n        return true\n    }\n\n    //% block=\"wykryj karte\"\n    //% group=\"Podstawowe\"\n    export function detect(): boolean {\n\n        if (!initialized) {\n            errorText = \"BRAK INICJALIZACJI\"\n            return false\n        }\n\n        for (let attempt = 0; attempt < 2; attempt++) {\n\n            if (detectOnce()) {\n                return true\n            }\n\n            if (errorText == \"BRAK KARTY\" ||\n                errorText == \"TO NIE CLASSIC 1K\" ||\n                errorText == \"NIEOBSLUGIWANA KARTA\") {\n                return false\n            }\n\n            basic.pause(100)\n        }\n\n        return false\n    }\n\n    //% block=\"UID karty\"\n    //% group=\"Podstawowe\"\n    export function uid(): string {\n        return cardUID\n    }\n\n    function authenticateBlock4(): boolean {\n\n        if (!cardPresent ||\n            uidBytes.length != 4) {\n\n            errorText = \"BRAK KARTY\"\n            return false\n        }\n\n        let data: number[] = [\n            0x60,\n            0x04,\n            0xFF, 0xFF, 0xFF,\n            0xFF, 0xFF, 0xFF\n        ]\n\n        for (let i = 0; i < 4; i++) {\n            data.push(uidBytes[i])\n        }\n\n        let r = exchange(data)\n\n        if (r.length < 3) {\n            if (errorText == \"\") {\n                errorText = \"BLAD AUTORYZACJI\"\n            }\n            return false\n        }\n\n        return true\n    }\n\n    //% block=\"odczytaj tekst\"\n    //% group=\"Pamiec karty\"\n    export function readText(): string {\n\n        errorText = \"\"\n\n        if (!authenticateBlock4()) {\n            return \"\"\n        }\n\n        let r = exchange([0x30, 0x04])\n\n        if (r.length < 19) {\n            if (errorText == \"\") {\n                errorText = \"BLAD ODCZYTU\"\n            }\n            return \"\"\n        }\n\n        let result = \"\"\n\n        for (let i = 0; i < 16; i++) {\n\n            let b = r[3 + i]\n\n            if (b == 0) {\n                break\n            }\n\n            result += String.fromCharCode(b)\n        }\n\n        return result\n    }\n\n    //% block=\"zapisz tekst %tekst\"\n    //% group=\"Pamiec karty\"\n    export function writeText(tekst: string): boolean {\n\n        errorText = \"\"\n\n        if (tekst.length > 16) {\n            errorText = \"TEKST ZA DLUGI\"\n            return false\n        }\n\n        for (let i = 0; i < tekst.length; i++) {\n\n            let code = tekst.charCodeAt(i)\n\n            if (code < 32 || code > 126) {\n                errorText = \"TYLKO ASCII\"\n                return false\n            }\n        }\n\n        if (!authenticateBlock4()) {\n            return false\n        }\n\n        let data: number[] = [0xA0, 0x04]\n\n        for (let i = 0; i < 16; i++) {\n\n            if (i < tekst.length) {\n                data.push(tekst.charCodeAt(i))\n            } else {\n                data.push(0)\n            }\n        }\n\n        let r = exchange(data)\n\n        if (r.length < 3) {\n            if (errorText == \"\") {\n                errorText = \"BLAD ZAPISU\"\n            }\n            return false\n        }\n\n        return true\n    }\n\n    //% block=\"ostatni blad\"\n    //% group=\"Diagnostyka\"\n    export function lastError(): string {\n        return errorText\n    }\n}","pxt.json":"{\n    \"name\": \"pxt-pn532-i2c\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"pn532.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794657332511}