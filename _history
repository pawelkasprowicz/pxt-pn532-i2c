e=\"ELSE\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">BLAD INICJALIZACJI</field></shadow></value><next><block type=\"serial_writeline\"><value name=\"text\"><block type=\"PN532_lastError\"></block></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.No</field></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":45,"diffs":[[1,"// ========================================\r\n// PN532 - TEST MIFARE CLASSIC 1K\r\n// micro:bit V2\r\n//\r\n// A - ODCZYT TEKSTU\r\n// B - ZAPIS TEKSTU \"PAWEL\"\r\n// ========================================\r\n\r\nserial.redirectToUSB()\r\n\r\nbasic.pause(1000)\r\n\r\nserial.writeLine(\"========================\")\r\nserial.writeLine(\"PN532 - TEST PAMIECI\")\r\nserial.writeLine(\"========================\")\r\n\r\nlet pn532Gotowy = PN532.init()\r\n\r\nif (pn532Gotowy) {\r\n    serial.writeLine(\"PN532 GOTOWY\")\r\n    basic.showIcon(IconNames.Yes)\r\n} else {\r\n    serial.writeLine(\"BLAD INICJALIZACJI\")\r\n    serial.writeLine(PN532.lastError())\r\n    basic.showIcon(IconNames.No)\r\n}\r\n\r\n// PRZYCISK A - ODCZYT\r\n\r\ninput.onButtonPressed(Button.A, function () {\r\n\r\n    serial.writeLine(\"\")\r\n    serial.writeLine(\"ODCZYT KARTY\")\r\n\r\n    if (!pn532Gotowy) {\r\n        serial.writeLine(\"CZYTNIK NIEGOTOWY\")\r\n        basic.showIcon(IconNames.No)\r\n        return\r\n    }\r\n\r\n    if (PN532.detect()) {\r\n\r\n        serial.writeLine(\"UID: \" + PN532.uid())\r\n\r\n        let tekst = PN532.readText()\r\n\r\n        if (PN532.lastError() == \"\") {\r\n            serial.writeLine(\"TEKST: \" + tekst)\r\n            basic.showIcon(IconNames.Yes)\r\n        } else {\r\n            serial.writeLine(\"BLAD: \" + PN532.lastError())\r\n            basic.showIcon(IconNames.No)\r\n        }\r\n\r\n    } else {\r\n        serial.writeLine(\"BLAD: \" + PN532.lastError())\r\n        basic.showIcon(IconNames.No)\r\n    }\r\n})\r\n\r\n// PRZYCISK B - ZAPIS\r\n\r\ninput.onButtonPressed(Button.B, function () {\r\n\r\n    serial.writeLine(\"\")\r\n    serial.writeLine(\"ZAPIS KARTY\")\r\n\r\n    if (!pn532Gotowy) {\r\n        serial.writeLine(\"CZYTNIK NIEGOTOWY\")\r\n        basic.showIcon(IconNames.No)\r\n        return\r\n    }\r\n\r\n    if (PN532.detect()) {\r\n\r\n        serial.writeLine(\"UID: \" + PN532.uid())\r\n\r\n        if (PN532.writeText(\"PAWEL\")) {\r\n            serial.writeLine(\"ZAPIS OK\")\r\n            basic.showIcon(IconNames.Yes)\r\n        } else {\r\n            serial.writeLine(\"BLAD: \" + PN532.lastError())\r\n            basic.showIcon(IconNames.No)\r\n        }\r\n\r\n    } else {\r\n        serial.writeLine(\"BLAD: \" + PN532.lastError())\r\n        basic.showIcon(IconNames.No)\r\n    }\r\n})"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":256,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tu są testy; nie będzie to kompilowane, gdy ten pakiet będzie używany jako rozszerzenie.\n"}]}],"snapshots":[{"timestamp":1794307008707,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"pxt-pn532-i2c\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1794312455928,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"257\" y=\"20\"></block></xml>","main.ts":"basic.forever(function () {\n\t\n})\n","README.md":"","pn532.ts":"\n/**\n* Użyj tego pliku, aby zdefiniować niestandardowe funkcje i bloki.\n* Czytaj więcej na https://makecode.microbit.org/blocks/custom\n*/\n\nenum MyEnum {\n    //% block=\"one\"\n    One,\n    //% block=\"two\"\n    Two\n}\n\n/**\n * Custom blocks\n */\n//% weight=100 color=#0fbc11 icon=\"\"\nnamespace custom {\n    /**\n     * TODO: describe your function here\n     * @param n describe parameter here, eg: 5\n     * @param s describe parameter here, eg: \"Hello\"\n     * @param e describe parameter here\n     */\n    //% block\n    export function foo(n: number, s: string, e: MyEnum): void {\n        // Add code here\n    }\n\n    /**\n     * TODO: describe your function here\n     * @param value describe value here, eg: 5\n     */\n    //% block\n    export function fib(value: number): number {\n        return value <= 1 ? value : fib(value -1) + fib(value - 2);\n    }\n}\n","pxt.json":"{\n    \"name\": \"pxt-pn532-i2c\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"pn532.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1794653428025,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"257\" y=\"20\"></block></xml>","main.ts":"// ========================================\n// PN532 - TEST DIAGNOSTYCZNY BIBLIOTEKI\n// micro:bit V2\n// ========================================\n\nserial.redirectToUSB()\n\nbasic.pause(1000)\n\nserial.writeLine(\"\")\nserial.writeLine(\"========================\")\nserial.writeLine(\"DIAGNOSTYKA PN532\")\nserial.writeLine(\"========================\")\n\nlet gotowy = PN532.init()\n\nif (gotowy) {\n    serial.writeLine(\"INICJALIZACJA: OK\")\n    basic.showIcon(IconNames.Yes)\n} else {\n    serial.writeLine(\"INICJALIZACJA: BLAD\")\n    serial.writeLine(\"POWOD: \" + PN532.lastError())\n    basic.showIcon(IconNames.No)\n}\n\nbasic.forever(function () {\n\n    if (gotowy) {\n\n        serial.writeLine(\"\")\n        serial.writeLine(\"ROZPOCZYNAM ODCZYT...\")\n\n        let start = input.runningTime()\n\n        let wykryto = PN532.detect()\n\n        let czas = input.runningTime() - start\n\n        serial.writeLine(\"CZAS: \" + czas + \" ms\")\n\n        if (wykryto) {\n\n            serial.writeLine(\"KARTA WYKRYTA\")\n            serial.writeLine(\"UID: \" + PN532.uid())\n            serial.writeLine(\"TYP: \" + PN532.type())\n            serial.writeLine(\"ATQA: \" + PN532.atqa())\n            serial.writeLine(\"SAK: \" + PN532.sak())\n            serial.writeLine(\"ATS: \" + PN532.ats())\n\n            basic.showIcon(IconNames.Yes)\n\n        } else {\n\n            serial.writeLine(\"NIE WYKRYTO KARTY\")\n            serial.writeLine(\"BLAD: \" + PN532.lastError())\n\n            basic.showIcon(IconNames.No)\n        }\n    }\n\n    basic.pause(1000)\n})","README.md":"","pn532.ts":"//% color=#00897B icon=\"\\uf2c2\" block=\"PN532 NFC\"\nnamespace PN532 {\n\n    const ADDRESS = 0x24\n\n    let initialized = false\n    let cardPresent = false\n\n    let cardUID = \"\"\n    let cardATQA = \"\"\n    let cardSAK = 0\n    let cardATS = \"\"\n    let cardType = \"\"\n    let errorText = \"\"\n\n    function hexByte(value: number): string {\n        let h = \"0123456789ABCDEF\"\n        return h.charAt((value >> 4) & 15) +\n            h.charAt(value & 15)\n    }\n\n    function sendCommand(data: number[]): boolean {\n        let len = data.length + 1\n        let lcs = (256 - len) & 255\n        let sum = 0xD4\n\n        for (let i = 0; i < data.length; i++) {\n            sum += data[i]\n        }\n\n        let dcs = (256 - (sum & 255)) & 255\n        let frame = pins.createBuffer(len + 8)\n\n        frame[0] = 0\n        frame[1] = 0\n        frame[2] = 255\n        frame[3] = len\n        frame[4] = lcs\n        frame[5] = 0xD4\n\n        for (let i = 0; i < data.length; i++) {\n            frame[6 + i] = data[i]\n        }\n\n        frame[6 + data.length] = dcs\n        frame[7 + data.length] = 0\n\n        return pins.i2cWriteBuffer(\n            ADDRESS, frame, false\n        ) == 0\n    }\n\n    function readFrame(size: number, timeout: number): Buffer {\n        let start = input.runningTime()\n\n        while (input.runningTime() - start < timeout) {\n            let status = pins.i2cReadBuffer(\n                ADDRESS, 1, false\n            )\n\n            if (status[0] == 1) {\n                return pins.i2cReadBuffer(\n                    ADDRESS, size, false\n                )\n            }\n\n            basic.pause(20)\n        }\n\n        return pins.createBuffer(0)\n    }\n\n    function command(data: number[], timeout: number): Buffer {\n        if (!sendCommand(data)) {\n            errorText = \"BLAD I2C\"\n            return pins.createBuffer(0)\n        }\n\n        let ack = readFrame(7, 1000)\n\n        if (ack.length != 7 ||\n            ack[0] != 1 ||\n            ack[1] != 0 ||\n            ack[2] != 0 ||\n            ack[3] != 255 ||\n            ack[4] != 0 ||\n            ack[5] != 255 ||\n            ack[6] != 0) {\n\n            errorText = \"BRAK ACK\"\n            return pins.createBuffer(0)\n        }\n\n        let raw = readFrame(64, timeout)\n\n        if (raw.length < 9) {\n            errorText = \"TIMEOUT\"\n            return pins.createBuffer(0)\n        }\n\n        if (raw[0] != 1 ||\n            raw[1] != 0 ||\n            raw[2] != 0 ||\n            raw[3] != 255) {\n\n            errorText = \"BLAD RAMKI\"\n            return pins.createBuffer(0)\n        }\n\n        let len = raw[4]\n\n        if (((len + raw[5]) & 255) != 0 ||\n            len + 8 > raw.length) {\n\n            errorText = \"BLAD DLUGOSCI\"\n            return pins.createBuffer(0)\n        }\n\n        let sum = 0\n\n        for (let i = 0; i < len; i++) {\n            sum += raw[6 + i]\n        }\n\n        if (((sum + raw[6 + len]) & 255) != 0) {\n            errorText = \"BLAD SUMY\"\n            return pins.createBuffer(0)\n        }\n\n        if (len == 1 && raw[6] == 0x7F) {\n            errorText = \"BLAD PN532\"\n            return pins.createBuffer(0)\n        }\n\n        let result = pins.createBuffer(len)\n\n        for (let i = 0; i < len; i++) {\n            result[i] = raw[6 + i]\n        }\n\n        return result\n    }\n\n    function clearCard() {\n        cardPresent = false\n        cardUID = \"\"\n        cardATQA = \"\"\n        cardSAK = 0\n        cardATS = \"\"\n        cardType = \"\"\n    }\n\n    //% block=\"inicjalizuj PN532\"\n    //% group=\"Podstawowe\"\n    export function init(): boolean {\n        clearCard()\n        initialized = false\n        errorText = \"\"\n\n        let r = command(\n            [0x14, 0x01, 0x14, 0x01],\n            1000\n        )\n\n        if (r.length < 2 ||\n            r[0] != 0xD5 ||\n            r[1] != 0x15) {\n\n            if (errorText == \"\") {\n                errorText = \"BLAD INICJALIZACJI\"\n            }\n\n            return false\n        }\n\n        initialized = true\n        return true\n    }\n\n    //% block=\"wykryj karte NFC\"\n    //% group=\"Podstawowe\"\n    export function detect(): boolean {\n        clearCard()\n        errorText = \"\"\n\n        if (!initialized) {\n            errorText = \"BRAK INICJALIZACJI\"\n            return false\n        }\n\n        let r = command(\n            [0x4A, 0x01, 0x00],\n            2500\n        )\n\n        if (r.length < 3 ||\n            r[0] != 0xD5 ||\n            r[1] != 0x4B) {\n\n            if (errorText =